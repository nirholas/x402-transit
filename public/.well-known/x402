{
  "x402Version": 1,
  "name": "x402-transit",
  "description": "Transit trip planning and live delay snapshots from open GTFS/GTFS-RT feeds, priced per query",
  "homepage": "https://nirholas.github.io/x402-transit/",
  "repository": "https://github.com/nirholas/x402-transit",
  "contact": "nichxbt@gmail.com",
  "skill": "/skill.md",
  "dataSource": {
    "upstream": "MBTA V3 API — a public, keyless JSON projection of GTFS static + GTFS-Realtime TripUpdates",
    "keyed": false,
    "envVars": [
      "GTFS_API_BASE",
      "GTFS_AGENCY_NAME",
      "GTFS_TIMEZONE",
      "GTFS_API_KEY (optional, raises rate limit only)"
    ],
    "fallback": "None by design. The feed is keyless and called live; if it is unreachable the service returns 502 rather than invented departure times."
  },
  "payment": {
    "protocol": "x402",
    "asset": "USDC",
    "note": "Pay in USDC on Base or Solana — your client picks the rail.",
    "rails": [
      {
        "rail": "evm",
        "network": "base-sepolia",
        "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
        "facilitator": "https://x402.org/facilitator"
      },
      {
        "rail": "solana",
        "network": "solana",
        "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
        "facilitator": "https://facilitator.payai.network"
      }
    ]
  },
  "resources": [
    {
      "resource": "GET /plan",
      "description": "Transit itinerary options between two stops — legs, routes, scheduled times, and realtime predictions where the feed has them",
      "price": "$0.002",
      "asset": "USDC",
      "network": "base-sepolia",
      "networks": [
        "base-sepolia",
        "solana"
      ],
      "accepts": [
        {
          "scheme": "exact",
          "network": "base-sepolia",
          "asset": "USDC",
          "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
          "maxAmountRequired": "2000",
          "mimeType": "application/json"
        },
        {
          "scheme": "exact",
          "network": "solana",
          "asset": "USDC",
          "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
          "maxAmountRequired": "2000",
          "mimeType": "application/json"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "Stop id (place-sstat), station name (South Station), or \"lat,lon\""
          },
          "to": {
            "type": "string",
            "description": "Same forms as from"
          },
          "departAfter": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601; defaults to now"
          },
          "max": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 3
          }
        },
        "required": [
          "from",
          "to"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "const": "gtfs-live"
          },
          "agency": {
            "type": "string"
          },
          "feed": {
            "type": "string"
          },
          "query": {
            "type": "object"
          },
          "itineraries": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "direct",
                    "one-transfer"
                  ]
                },
                "departure": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "arrival": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "durationMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "transfers": {
                  "type": "integer"
                },
                "legs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "routeId": {
                        "type": "string"
                      },
                      "routeName": {
                        "type": "string"
                      },
                      "routeType": {
                        "type": "string",
                        "description": "subway | light-rail | commuter-rail | bus | ferry | transit"
                      },
                      "headsign": {
                        "type": "string"
                      },
                      "tripId": {
                        "type": "string"
                      },
                      "from": {
                        "type": "object",
                        "properties": {
                          "stopId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "scheduledDeparture": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "predictedDeparture": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      },
                      "to": {
                        "type": "object",
                        "properties": {
                          "stopId": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "scheduledArrival": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "predictedArrival": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      },
                      "durationMinutes": {
                        "type": [
                          "integer",
                          "null"
                        ]
                      },
                      "realtime": {
                        "type": "boolean",
                        "description": "true when the realtime feed had an update for this trip"
                      }
                    }
                  }
                }
              },
              "required": [
                "kind",
                "legs",
                "transfers"
              ]
            }
          },
          "note": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "itineraries",
          "retrievedAt"
        ]
      }
    },
    {
      "resource": "GET /delays",
      "description": "Live delay snapshot for a stop (optionally one route) — realtime prediction minus scheduled time per upcoming arrival, plus a summary",
      "price": "$0.001",
      "asset": "USDC",
      "network": "base-sepolia",
      "networks": [
        "base-sepolia",
        "solana"
      ],
      "accepts": [
        {
          "scheme": "exact",
          "network": "base-sepolia",
          "asset": "USDC",
          "payTo": "0x40252CFDF8B20Ed757D61ff157719F33Ec332402",
          "maxAmountRequired": "1000",
          "mimeType": "application/json"
        },
        {
          "scheme": "exact",
          "network": "solana",
          "asset": "USDC",
          "payTo": "WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW",
          "maxAmountRequired": "1000",
          "mimeType": "application/json"
        }
      ],
      "inputSchema": {
        "type": "object",
        "properties": {
          "stop": {
            "type": "string",
            "description": "Stop id, station name, or \"lat,lon\""
          },
          "route": {
            "type": "string",
            "description": "Optional routeId filter, e.g. Red"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 20
          }
        },
        "required": [
          "stop"
        ]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "source": {
            "const": "gtfs-rt-live"
          },
          "agency": {
            "type": "string"
          },
          "feed": {
            "type": "string"
          },
          "query": {
            "type": "object"
          },
          "summary": {
            "type": "object",
            "properties": {
              "predictions": {
                "type": "integer"
              },
              "withSchedule": {
                "type": "integer"
              },
              "onTime": {
                "type": "integer"
              },
              "late": {
                "type": "integer"
              },
              "early": {
                "type": "integer"
              },
              "medianDelaySeconds": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "worstDelaySeconds": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "verdict": {
                "enum": [
                  "no-data",
                  "running-well",
                  "minor-delays",
                  "significant-delays"
                ]
              }
            }
          },
          "arrivals": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "routeId": {
                  "type": "string"
                },
                "routeName": {
                  "type": "string"
                },
                "tripId": {
                  "type": "string"
                },
                "headsign": {
                  "type": "string"
                },
                "directionId": {
                  "type": "integer"
                },
                "stopId": {
                  "type": "string"
                },
                "scheduled": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "predicted": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "delaySeconds": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "delayMinutes": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "status": {
                  "enum": [
                    "early",
                    "on-time",
                    "late",
                    "unknown"
                  ]
                },
                "uncertaintySeconds": {
                  "type": [
                    "integer",
                    "null"
                  ]
                }
              }
            }
          },
          "note": {
            "type": "string"
          },
          "retrievedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source",
          "summary",
          "arrivals",
          "retrievedAt"
        ]
      }
    }
  ]
}
